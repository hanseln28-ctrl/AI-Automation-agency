# IRON Creator OS — Environment Variables
# Copy this to .env.local and fill in your values
# Never commit .env.local to version control

# =============================================================================
# Clerk Authentication (https://clerk.com)
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Clerk webhook signing secret (for syncing user data)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# =============================================================================
# Supabase (PostgreSQL + Storage) (https://supabase.com)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxx
# Service role key — NEVER expose to client. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxx

# =============================================================================
# Database (Prisma connection string)
# =============================================================================
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Use the Session Pooler connection string (port 6543) for Prisma
DATABASE_URL=postgresql://postgres:xxxxxxxxxxxx@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection URL for migrations (bypass pgbouncer)
DIRECT_URL=postgresql://postgres:xxxxxxxxxxxx@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# =============================================================================
# OpenAI (AI Pipeline) (https://platform.openai.com)
# =============================================================================
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# =============================================================================
# Stripe (Payments) (https://stripe.com)
# =============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# =============================================================================
# Application
# =============================================================================
# Base URL of the application (for webhook callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Optional: Upstash Redis (for BullMQ queues + caching)
# =============================================================================
# UPSTASH_REDIS_URL=redis://xxxxxxxxxxxx
# UPSTASH_REDIS_TOKEN=xxxxxxxxxxxx

# =============================================================================
# Optional: Cloudflare R2 (object storage for videos)
# =============================================================================
# R2_ACCOUNT_ID=xxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxx
# R2_BUCKET_NAME=iron-creator-os
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
